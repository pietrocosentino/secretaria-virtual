# Copie para .env.local. Nunca publique credenciais.
PORT=3000
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Use a versão suportada exibida no painel da Meta (formato vN.N).
META_GRAPH_VERSION=
# Números autorizados para este piloto, dígitos com país e DDD, separados por vírgula.
WHATSAPP_ALLOWED_NUMBERS=
# Arquivo local: somente uma instância Node com disco persistente.
DATA_FILE=data/pilot.json
ADMIN_TOKEN=

# Destinatário do teste de envio real; deve constar na lista acima.
WHATSAPP_TEST_RECIPIENT=
