{
  "name": "secretaria-virtual",
  "version": "0.1.0",
  "description": "Secretária virtual para WhatsApp (webhook da Meta)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.mjs",
    "test:prototype": "node tests/prototype.test.cjs --stress=10000 --report=docs/qa/resultado-prototipo.json",
    "test:stress": "node scripts/qa-stress.mjs",
    "test:regression": "npm test && npm run test:prototype"
  },
  "engines": {
    "node": ">=18"
  }
}
